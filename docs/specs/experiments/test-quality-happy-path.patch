@@ -207,3 +207,21 @@ export function isImportableContentType(contentType: string | null): boolean {
   const mime = contentType.split(';')[0]!.trim().toLowerCase();
   return (URL_IMPORT_CONTENT_TYPES as readonly string[]).includes(mime);
 }
+
+/**
+ * URL/file-safe slug for a skill name, capped at `maxLength` on a word
+ * boundary. Used for exported skill folders.
+ */
+export function skillSlug(name: string, maxLength = 40): string {
+  const slug = name
+    .normalize('NFKD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (!slug) return 'skill';
+  if (slug.length <= maxLength) return slug;
+  const cut = slug.slice(0, maxLength);
+  const lastDash = cut.lastIndexOf('-');
+  return lastDash > 0 ? cut.slice(0, lastDash) : cut;
+}
